ENVIRONMENT=development
DATABASE_URL=sqlite:///./zenos.db
SECRET_KEY=replace-with-a-long-random-secret
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep password mode until a verified Brevo sender and API key are configured.
# Set AUTH_MODE=otp to enable email codes and disable password login/registration.
AUTH_MODE=password
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ZenOS
OTP_DAILY_SEND_LIMIT=200
